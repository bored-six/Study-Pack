{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx expo export -p web && node scripts/postexport.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/nib.ts": { "maxDuration": 120 }
  },
  "cleanUrls": true,
  "rewrites": [
    { "source": "/exam/(.*)", "destination": "/exam/[deckId]" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
